{
  "name": "age-of-war-mobile",
  "version": "0.1.0",
  "description": "Age of War inspired mobile lane-war game with ragdoll physics",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "multiplayer": "tsx server/index.ts",
    "test:multiplayer": "node scripts/multiplayer-test.mjs",
    "test:multiplayer-ui": "node scripts/multiplayer-ui-test.mjs",
    "test:online-storage": "node --import tsx scripts/online-storage-check.ts",
    "test:accounts": "node scripts/accounts-test.mjs",
    "test:accounts-ui": "node scripts/accounts-ui-test.mjs",
    "backup:online": "node scripts/backup-online.mjs",
    "test:cosmetics": "node scripts/cosmetics-check.mjs",
    "test:unit-art": "node scripts/unit-art-check.mjs",
    "test:progression": "node --import tsx scripts/progression-check.ts",
    "test:progression-ui": "node scripts/progression-ui-check.mjs",
    "test:offline-save-ui": "node scripts/offline-save-ui-check.mjs",
    "test:survival-result-ui": "node scripts/survival-result-ui-check.mjs",
    "cap:sync": "npm run build && cap sync"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/tahmiduddin26-stack/Wargame"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0",
    "zustand": "^5.0.14"
  },
  "private": true,
  "type": "module"
}

# Machine-local harness config. The impeccable design hook writes an absolute
# path to the installed skill here, which is specific to this machine.
.claude/settings.local.json

# Capacitor native shells.
#
# The Android project is committed so it opens straight in Android Studio and so
# any native customisation (the landscape lock in AndroidManifest, splash colour,
# icons) is tracked. Its own android/.gitignore excludes the regenerable and
# machine-specific parts: build output, .gradle, local.properties, the copied
# web assets and the generated capacitor config. After cloning, run
# `npm run build && npx cap sync android` to repopulate those before building.
#
# iOS is still generated on demand (`npx cap add ios`), because it needs macOS.
/ios/

# TypeScript incremental build metadata
tsconfig.tsbuildinfo
